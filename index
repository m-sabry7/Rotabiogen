                    <a href="tel:+201207776848" class="contact-item"><i class="fa-solid fa-phone"></i> <span dir="ltr">+20 120 777 6848</span></a>
                    <a href="https://www.linkedin.com/in/m-sabry129/" target="_blank" class="contact-item"><i class="fa-brands fa-linkedin"></i> LinkedIn</a>
                </div>
            </div>
        </div>

        <h2 class="portfolio-main-title" data-aos="fade-up">
            <span class="ar">الإنجازات التقنية</span>
            <span class="en">Technical Achievements</span>
