<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rotabiogen | Technical Achievements</title>
    
    <!-- Prevent Auto-Translation -->
    <meta name="google" content="notranslate" />
    <meta http-equiv="Content-Language" content="ar" />
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;900&family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">
    
    <!-- Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Animation Library -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

    <style>
        :root {
            --bg-primary: #0f172a;
            --bg-secondary: #1e293b;
            --brand-purple: #8b5cf6;
            --brand-orange: #f59e0b;
            --accent-cyan: #06b6d4;
            --accent-green: #10b981;
            --accent-red: #ef4444;
            --text-light: #f1f5f9;
            --text-gray: #94a3b8;
            --glass: rgba(30, 41, 59, 0.7);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Cairo', 'Inter', sans-serif;
            background-color: var(--bg-primary);
            color: var(--text-light);
            overflow-x: hidden;
            line-height: 1.7;
        }

        .bg-animation {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -1;
            background: 
                radial-gradient(circle at 15% 15%, rgba(139, 92, 246, 0.15) 0%, transparent 25%),
                radial-gradient(circle at 85% 85%, rgba(245, 158, 11, 0.1) 0%, transparent 25%),
                radial-gradient(circle at 50% 50%, rgba(6, 182, 212, 0.05) 0%, transparent 50%);
        }

        .container { max-width: 1200px; margin: 0 auto; padding: 0 20px; }

        /* Language Switcher */
        .lang-switch {
            position: fixed; top: 20px; right: 20px; z-index: 1000;
            background: var(--glass); border: 1px solid var(--brand-purple);
            color: var(--text-light); padding: 8px 15px; border-radius: 8px;
            cursor: pointer; backdrop-filter: blur(10px); font-weight: 700;
            transition: all 0.3s; font-family: 'Cairo', sans-serif;
        }
        .lang-switch:hover { background: var(--brand-purple); transform: translateY(-2px); }
        html[lang="en"] .lang-switch { right: auto; left: 20px; }

        /* Language Visibility */
        html[lang="ar"] .en { display: none; }
        html[lang="en"] .ar { display: none; }

        /* Header & Profile Card */
        header { text-align: center; padding: 60px 0 20px; }

        .logo {
            width: 160px; margin-bottom: 40px;
            filter: drop-shadow(0 10px 25px rgba(139, 92, 246, 0.4));
            transition: transform 0.5s;
        }
        .logo:hover { transform: scale(1.05); }

        .profile-card {
            background: var(--glass); backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 20px;
            padding: 40px; max-width: 800px; margin: 0 auto 40px;
            display: flex; align-items: center; gap: 30px;
            transition: transform 0.3s, box-shadow 0.3s; position: relative; overflow: hidden;
        }

        .profile-card::before {
            content: ''; position: absolute; top: 0; right: 0;
            width: 100%; height: 4px; background: linear-gradient(to left, var(--brand-purple), var(--brand-orange));
        }
        html[lang="en"] .profile-card::before { background: linear-gradient(to right, var(--brand-purple), var(--brand-orange)); }

        .profile-card:hover { transform: translateY(-5px); box-shadow: 0 15px 30px rgba(139, 92, 246, 0.15); }

        .profile-img {
            width: 120px; height: 120px; border-radius: 50%;
            background: linear-gradient(135deg, var(--brand-purple), var(--brand-orange));
            display: flex; align-items: center; justify-content: center; flex-shrink: 0;
            box-shadow: 0 8px 20px rgba(139, 92, 246, 0.3); border: 4px solid var(--bg-primary); overflow: hidden;
        }
        .profile-img img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; transition: transform 0.5s; }
        .profile-img:hover img { transform: scale(1.1); }

        .profile-info { text-align: right; flex-grow: 1; }
        html[lang="en"] .profile-info { text-align: left; }

        .profile-name {
            font-size: 2rem; font-weight: 900;
            background: linear-gradient(to left, #ffffff, var(--brand-purple));
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; margin-bottom: 5px;
        }
        html[lang="en"] .profile-name { background: linear-gradient(to right, #ffffff, var(--brand-purple)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }

        .profile-title {
            color: var(--brand-orange); font-size: 1.1rem; font-weight: 700;
            margin-bottom: 15px; display: flex; align-items: center; gap: 8px;
        }

        .contact-links { display: flex; flex-wrap: wrap; gap: 15px; }
        .contact-item {
            display: flex; align-items: center; gap: 6px; color: var(--text-gray);
            font-size: 0.9rem; text-decoration: none; transition: color 0.3s;
        }
        .contact-item i { color: var(--brand-purple); }
        .contact-item:hover { color: var(--text-light); }

        .portfolio-main-title {
            font-size: 2.5rem; font-weight: 900; text-align: center;
            background: linear-gradient(to left, #ffffff, var(--accent-cyan));
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; margin-bottom: 15px;
        }
        html[lang="en"] .portfolio-main-title { background: linear-gradient(to right, #ffffff, var(--accent-cyan)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        
        .portfolio-subtitle { text-align: center; font-size: 1rem; color: var(--text-gray); max-width: 700px; margin: 0 auto 60px; }

        /* Phase 1: Inherited State */
        .phase-section { margin-bottom: 80px; }
        .section-title {
            font-size: 2rem; font-weight: 800; margin-bottom: 20px; text-align: center;
            display: flex; align-items: center; justify-content: center; gap: 15px;
        }
        .section-desc {
            text-align: center; color: var(--text-gray); max-width: 800px;
            margin: 0 auto 40px; font-size: 1.05rem;
        }

        .danger-zone .section-title span { color: var(--accent-red); }
        .danger-zone .section-desc { border-right: 3px solid var(--accent-red); padding-right: 15px; }
        html[lang="en"] .danger-zone .section-desc { border-right: none; border-left: 3px solid var(--accent-red); padding-right: 0; padding-left: 15px; }

        .issues-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 15px; }
        .issue-item {
            background: rgba(239, 68, 68, 0.05); border: 1px solid rgba(239, 68, 68, 0.2);
            border-radius: 10px; padding: 15px; display: flex; align-items: center; gap: 10px;
            font-size: 0.95rem; transition: all 0.3s;
        }
        .issue-item i { color: var(--accent-red); font-size: 1.2rem; flex-shrink: 0; }
        .issue-item:hover { background: rgba(239, 68, 68, 0.1); transform: translateX(-5px); }
        html[lang="en"] .issue-item:hover { transform: translateX(5px); }

        /* Phase 2: Timeline Projects */
        .timeline { position: relative; padding: 40px 0; }
        .timeline::before {
            content: ''; position: absolute; top: 0; right: 50%; width: 2px; height: 100%;
            background: linear-gradient(to bottom, var(--brand-purple), var(--brand-orange)); transform: translateX(50%);
        }
        html[lang="en"] .timeline::before { right: auto; left: 50%; transform: translateX(-50%); }

        .timeline-item { position: relative; margin-bottom: 60px; width: 50%; }
        .timeline-item:nth-child(odd) { padding-left: 40px; margin-right: auto; }
        .timeline-item:nth-child(even) { padding-right: 40px; margin-left: auto; }
        html[lang="en"] .timeline-item:nth-child(odd) { padding-left: 0; padding-right: 40px; margin-right: 0; margin-left: auto; }
        html[lang="en"] .timeline-item:nth-child(even) { padding-right: 0; padding-left: 40px; margin-left: 0; margin-right: auto; }

        .timeline-dot {
            position: absolute; top: 20px; width: 20px; height: 20px; background: var(--bg-primary);
            border: 4px solid var(--brand-purple); border-radius: 50%; z-index: 1; box-shadow: 0 0 15px rgba(139, 92, 246, 0.5);
        }
        .timeline-item:nth-child(odd) .timeline-dot { left: -10px; right: auto; }
        .timeline-item:nth-child(even) .timeline-dot { right: -10px; left: auto; }
        html[lang="en"] .timeline-item:nth-child(odd) .timeline-dot { right: -10px; left: auto; }
        html[lang="en"] .timeline-item:nth-child(even) .timeline-dot { left: -10px; right: auto; }

        .project-card {
            background: var(--glass); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px; padding: 30px; transition: all 0.3s; position: relative; overflow: hidden;
        }
        .project-card::before {
            content: ''; position: absolute; top: 0; right: 0; width: 100%; height: 4px;
            background: linear-gradient(to left, var(--brand-purple), var(--brand-orange));
        }
        html[lang="en"] .project-card::before { background: linear-gradient(to right, var(--brand-purple), var(--brand-orange)); }
        .project-card:hover { border-color: var(--brand-purple); box-shadow: 0 10px 30px rgba(139, 92, 246, 0.15); transform: translateY(-5px); }

        .project-header { display: flex; align-items: center; gap: 15px; margin-bottom: 20px; }
        .project-icon {
            width: 50px; height: 50px; background: rgba(139, 92, 246, 0.1); border-radius: 12px;
            display: flex; align-items: center; justify-content: center; color: var(--brand-purple); font-size: 1.5rem;
        }
        .project-title h3 { font-size: 1rem; color: var(--brand-orange); font-weight: 700; }
        .project-title h2 { font-size: 1.3rem; font-weight: 800; }

        .project-list { list-style: none; margin-bottom: 20px; }
        .project-list li { position: relative; padding-right: 20px; margin-bottom: 8px; color: var(--text-gray); }
        .project-list li::before { content: '▪'; position: absolute; right: 0; color: var(--brand-purple); }
        html[lang="en"] .project-list li { padding-right: 0; padding-left: 20px; }
        html[lang="en"] .project-list li::before { right: auto; left: 0; }

        .result-box {
            background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.3);
            border-radius: 8px; padding: 15px; display: flex; align-items: center; gap: 10px;
        }
        .result-box i { color: var(--accent-green); font-size: 1.2rem; }
        .result-box p { color: var(--accent-green); font-weight: 600; font-size: 0.95rem; }

        .sub-projects { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 20px; }
        .sub-card { background: rgba(255,255,255,0.03); border-radius: 8px; padding: 15px; }
        .sub-card h4 { color: var(--brand-orange); margin-bottom: 10px; display:flex; align-items:center; gap:8px; }

        /* Phase 3: Current & Future State */
        .success-zone .section-title span { color: var(--accent-green); }
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-bottom: 40px; }

        .stat-card {
            background: var(--glass); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px; padding: 30px; text-align: center; transition: transform 0.3s, border-color 0.3s;
        }
        .stat-card:hover { transform: translateY(-5px); border-color: var(--brand-purple); }
        .stat-number {
            font-size: 3rem; font-weight: 800;
            background: linear-gradient(135deg, var(--brand-purple), var(--brand-orange));
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        }
        .stat-text { color: var(--text-gray); font-size: 1rem; font-weight: 600; }

        .ongoing-dev {
            background: linear-gradient(135deg, rgba(139, 92, 246, 0.1), rgba(245, 158, 11, 0.1));
            border: 1px solid var(--brand-purple); border-radius: 16px; padding: 30px; text-align: center;
            box-shadow: 0 0 30px rgba(139, 92, 246, 0.1); margin-bottom: 40px;
        }
        .ongoing-dev h3 { font-size: 1.5rem; color: var(--brand-orange); margin-bottom: 15px; }
        .ongoing-dev p { color: var(--text-gray); font-size: 1.05rem; max-width: 600px; margin: 0 auto; }

        .continuous-section {
            background: var(--glass); backdrop-filter: blur(12px); border: 1px solid var(--brand-orange);
            border-radius: 16px; padding: 40px; position: relative; overflow: hidden;
        }
        .continuous-section::before {
            content: ''; position: absolute; bottom: 0; right: 0; width: 100%; height: 4px;
            background: linear-gradient(to left, var(--brand-orange), var(--accent-green));
        }
        html[lang="en"] .continuous-section::before { background: linear-gradient(to right, var(--brand-orange), var(--accent-green)); }
        
        .ci-title { display: flex; align-items: center; justify-content: center; gap: 15px; font-size: 1.8rem; font-weight: 800; color: var(--brand-orange); margin-bottom: 30px; }
        .ci-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; }
        .ci-card { background: rgba(245, 158, 11, 0.05); border: 1px solid rgba(245, 158, 11, 0.2); border-radius: 12px; padding: 20px; transition: all 0.3s; }
        .ci-card:hover { transform: translateY(-5px); background: rgba(245, 158, 11, 0.1); border-color: var(--brand-orange); }
        .ci-card h4 { display: flex; align-items: center; gap: 10px; color: var(--brand-orange); margin-bottom: 10px; font-size: 1.1rem; }
        .ci-card p { color: var(--text-gray); font-size: 0.95rem; }

        footer { text-align: center; padding: 40px 0; color: var(--text-gray); font-size: 0.9rem; }

        /* Responsive - Fix Mobile Centering for Both Languages */
        @media (max-width: 768px) {
            .profile-card { flex-direction: column; text-align: center; }
            .profile-info, html[lang="en"] .profile-info { text-align: center; }
            .profile-title { justify-content: center; }
            .contact-links { justify-content: center; }
            .portfolio-main-title { font-size: 2rem; }
            .timeline::before { right: 20px; left: auto; transform: none; }
            .timeline-item { width: 100%; padding-left: 50px !important; padding-right: 0 !important; margin-left: 0 !important; margin-right: 0 !important; }
            .timeline-dot { right: auto !important; left: 10px !important; }
            .sub-projects { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

    <div class="bg-animation"></div>

    <!-- Language Switch Button -->
    <button class="lang-switch" onclick="toggleLanguage()">
        <span class="ar">English</span>
